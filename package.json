{
  "name": "batwa",
  "version": "1.0.0",
  "description": "Batwa - offline daily expense, income and loan tracker",
  "private": true,
  "scripts": {
    "assets": "capacitor-assets generate --android",
    "add:android": "cap add android",
    "sync": "cap sync android",
